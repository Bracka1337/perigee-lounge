parameters:
  paths:
    - app
    - routes
    - database
    - config
  level: 8
  tmpDir: storage/framework/cache/phpstan
  checkMissingTypehints: true
  checkUninitializedProperties: true

  strictRules:
    # Flags Eloquent's normal static-style calls on builder instances, which is how Laravel is meant to be used.
    dynamicCallOnStaticMethod: false

  # Checked by spaze/phpstan-disallowed-calls.
  disallowedFunctionCalls:
    - function: ['dd()', 'dump()', 'var_dump()', 'print_r()', 'ray()']
      message: 'remove debug output before committing'
    - function: 'env()'
      message: 'read settings with config(); env() returns null once config is cached'
      allowIn:
        - config/*
