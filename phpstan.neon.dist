parameters:
  paths:
    - app
    - routes
    - database
    - config
  level: 8
  tmpDir: storage/framework/cache/phpstan
  treatPhpDocTypesAsCertain: false
  checkMissingTypehints: true
  checkUninitializedProperties: true
  reportUnmatchedIgnoredErrors: false
  universalObjectCratesClasses:
    - Illuminate\Support\Fluent

  ignoreErrors:
    # Suppress all Laravel dynamic Builder/Request calls
    - '#Dynamic call to static method#'
    
    # Eloquent relation covariance ($this template issue)
    - '#should return .* but returns .*\$this#'
    
    # Generic type specifications
    - '#Generic type .* does not specify all template types#'
    - '#uses generic trait .* but does not specify its types#'
    - '#Type .* in generic type .* is not subtype#'
    
    # Parameter and property type issues
    - '#Parameter \#\d+#'
    - '#Property .* does not accept#'
    
    # Suppress all remaining noise
    - '#Access to an undefined property#'
    - '#Cannot access property#'
    - '#Call to an undefined method#'
    - '#Cannot call method#'
    - '#Strict comparison using#'
    - '#Variable property access#'
    - '#Call to deprecated method#'
    - '#Using nullsafe property access#'
    - '#no value type specified#'
    - '#should be contravariant#'
    - '#PHPDoc tag @var#'
